<views:ThemedContentDialog
    x:Class="AdbTether.Views.UpdateErrorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:AdbTether.Views"
    Title="Update check failed"
    CloseButtonText="Close"
    DefaultButton="Close"
    MinWidth="380"
    MaxWidth="440">

    <StackPanel Spacing="12">

        <TextBlock Text="AdbTether could not reach GitHub to check for a new release."
                   FontSize="14" TextWrapping="Wrap"
                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>

        <Border CornerRadius="8" BorderThickness="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Padding="14,12">
            <StackPanel Spacing="3">
                <TextBlock Text="Details" FontSize="11"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock x:Name="DetailText" FontSize="12" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
            </StackPanel>
        </Border>

    </StackPanel>
</views:ThemedContentDialog>
