<views:ThemedContentDialog
    x:Class="AdbTether.Views.UpdateDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:AdbTether.Views"
    Title="Update available"
    CloseButtonText="Not now"
    PrimaryButtonText="Download &amp; install"
    PrimaryButtonStyle="{ThemeResource AccentButtonStyle}"
    DefaultButton="Primary">

    <!--
      Width lives on the content, never on the ContentDialog: a MinWidth/MaxWidth
      on the dialog itself also constrains its smoke layer, which drags the whole
      dialog off center. The upper bound matters because the release notes wrap,
      and a wrapping TextBlock otherwise reports the full width it was offered
      and stretches the dialog across the window.
    -->
    <StackPanel MinWidth="360" MaxWidth="400" Spacing="10">

        <!-- Intro: the badge gives the prompt a focal point above the details. -->
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border
                Width="40"
                Height="40"
                CornerRadius="20"
                VerticalAlignment="Center"
                Background="{ThemeResource AccentFillColorDefaultBrush}">
                <FontIcon
                    Glyph="&#xE777;"
                    FontSize="18"
                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
            </Border>

            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                Text="A newer version of AdbTether is ready to install."
                Style="{StaticResource BodyTextBlockStyle}"
                TextWrapping="Wrap"/>
        </Grid>

        <!-- Installed vs available -->
        <Border
            CornerRadius="{ThemeResource OverlayCornerRadius}"
            BorderThickness="1"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            Padding="16,10">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="2">
                    <TextBlock
                        Text="Installed"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock
                        Text="{Binding CurrentVersionText}"
                        Style="{StaticResource BodyStrongTextBlockStyle}"/>
                </StackPanel>

                <FontIcon
                    Grid.Column="1"
                    Glyph="&#xE72A;"
                    FontSize="14"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                <StackPanel Grid.Column="2" Spacing="2" HorizontalAlignment="Right">
                    <TextBlock
                        Text="Available"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock
                        Text="{Binding LatestVersion}"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                    <TextBlock
                        Text="{Binding DownloadSizeText}"
                        Visibility="{Binding DownloadSizeVisibility}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- What's new. Release notes run long, so they scroll in a fixed box
             instead of stretching the dialog past the window. -->
        <StackPanel Spacing="6" Visibility="{Binding ReleaseNotesVisibility}">
            <TextBlock Text="What's new" Style="{StaticResource BodyStrongTextBlockStyle}"/>

            <Border
                CornerRadius="{ThemeResource OverlayCornerRadius}"
                BorderThickness="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Padding="12,8">
                <ScrollViewer MaxHeight="114" VerticalScrollBarVisibility="Auto">
                    <TextBlock
                        Text="{Binding ReleaseNotes}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        TextWrapping="Wrap"
                        LineHeight="19"
                        LineStackingStrategy="BlockLineHeight"
                        IsTextSelectionEnabled="True"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </ScrollViewer>
            </Border>
        </StackPanel>

        <!-- Offered by the startup prompt only; the Settings check hides it. -->
        <CheckBox
            Content="Don't check for updates at startup"
            Visibility="{Binding SkipOptionVisibility}"
            IsChecked="{Binding SkipStartupPrompt, Mode=TwoWay}"/>

        <StackPanel Spacing="6" Visibility="{Binding ProgressVisibility}">
            <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress}"/>
            <TextBlock
                Text="{Binding ProgressText}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <TextBlock
            Text="{Binding Error}"
            Visibility="{Binding ErrorVisibility}"
            Style="{StaticResource CaptionTextBlockStyle}"
            TextWrapping="Wrap"
            Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
    </StackPanel>
</views:ThemedContentDialog>
