<views:ThemedContentDialog
    x:Class="AdbTether.Views.UpdateDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:AdbTether.Views"
    Title="Update Available"
    CloseButtonText="Skip"
    PrimaryButtonText="Download &amp; Install"
    PrimaryButtonStyle="{ThemeResource AccentButtonStyle}"
    DefaultButton="Primary"
    MinWidth="380"
    MaxWidth="420">

    <StackPanel Spacing="16">

        <TextBlock Text="A new version of AdbTether is available."
                   FontSize="14" TextWrapping="Wrap"
                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>

        <!-- Version comparison card -->
        <Border CornerRadius="8" BorderThickness="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Padding="14,12">
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="1">
                    <TextBlock Text="Current version" FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="{Binding CurrentVersionText}" FontSize="14" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="1" HorizontalAlignment="Right">
                    <TextBlock Text="New version" FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="{Binding LatestVersion}" FontSize="14" FontWeight="SemiBold"
                               Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Progress -->
        <StackPanel Visibility="{Binding ProgressVisibility}" Spacing="6">
            <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress}"/>
            <TextBlock Text="{Binding ProgressText}" FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <!-- Error -->
        <TextBlock Text="{Binding Error}" Visibility="{Binding ErrorVisibility}"
                   FontSize="12" TextWrapping="Wrap"
                   Foreground="{ThemeResource TextFillColorCriticalBrush}"/>
    </StackPanel>
</views:ThemedContentDialog>
