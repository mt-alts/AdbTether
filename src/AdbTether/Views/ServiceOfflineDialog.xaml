<views:ThemedContentDialog
    x:Class="AdbTether.Views.ServiceOfflineDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:AdbTether.Views"
    Title="AdbTether service is not running"
    PrimaryButtonText="Retry"
    CloseButtonText="Close"
    PrimaryButtonStyle="{ThemeResource AccentButtonStyle}"
    DefaultButton="Primary">

    <!--
      Width lives on the content, never on the ContentDialog: a MinWidth/MaxWidth
      on the dialog itself also constrains its smoke layer, which drags the whole
      dialog off center.
    -->
    <StackPanel MinWidth="360" MaxWidth="420" Spacing="12">

        <TextBlock Text="AdbTether controls the tunnel through its background service (AdbTetherService) over 127.0.0.1:47012. The service is not reachable, so the tunnel and live status are unavailable."
                   FontSize="14" TextWrapping="Wrap"
                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>

        <Border CornerRadius="8" BorderThickness="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Padding="14,12">
            <StackPanel Spacing="10">

                <StackPanel Spacing="3">
                    <TextBlock Text="Start the installed service" FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="sc.exe start AdbTetherService"
                               FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                </StackPanel>

                <StackPanel Spacing="3">
                    <TextBlock Text="Install it (elevated PowerShell, from the repo root)" FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="powershell -ExecutionPolicy Bypass -File src\AdbTetherService\install.ps1"
                               FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                </StackPanel>

            </StackPanel>
        </Border>

        <TextBlock x:Name="DetailText" FontSize="12" TextWrapping="Wrap"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

    </StackPanel>
</views:ThemedContentDialog>
