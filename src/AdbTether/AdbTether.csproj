<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>AdbTether</RootNamespace>
    <AssemblyName>AdbTether</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <ApplicationIcon>adbtether.ico</ApplicationIcon>
    <Version>0.1.5</Version>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="adbtether.ico" />
    <Content Include="Assets\adbtether.svg" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.250907003" />
    <PackageReference Include="AdvancedSharpAdbClient" Version="3.6.16" />
  </ItemGroup>

  <ItemGroup>
    <!-- Rust engine (cdylib) + wintun, produced into the workspace target dir -->
    <None Include="..\..\target\release\adbtether_core.dll" Link="AdbTether_core.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\crates\engine\wintun.dll" Link="wintun.dll" CopyToOutputDirectory="PreserveNewest" />
    <!-- Android ws-proxy binary, pushed to device on connect (optional: only
         present after crates/ws-proxy/run.ps1 has cross-compiled it) -->
    <None Include="..\..\target\aarch64-linux-android\release\ws-proxy" Link="ws-proxy" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\target\aarch64-linux-android\release\ws-proxy')" />
  </ItemGroup>

  <ItemGroup>
    <!-- adb ships with the app so users do not need Android platform-tools -->
    <None Include="..\..\vendor\platform-tools\adb.exe" Link="adb.exe" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\vendor\platform-tools\AdbWinApi.dll" Link="AdbWinApi.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\vendor\platform-tools\AdbWinUsbApi.dll" Link="AdbWinUsbApi.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\vendor\platform-tools\NOTICE.txt" Link="NOTICE.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
