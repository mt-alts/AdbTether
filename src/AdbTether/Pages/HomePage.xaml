<Page
    x:Class="AdbTether.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ctrl="using:AdbTether.Controls"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Padding="20,14,20,18" RowSpacing="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header (removed - title bar shows the app name) -->

            <!-- Device card -->
            <Border Grid.Row="0" CornerRadius="12" BorderThickness="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Padding="14,12">
                <StackPanel Spacing="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="ANDROID DEVICE" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Padding="8" ToolTipService.ToolTip="Refresh Devices"
                                Command="{Binding Device.RefreshCommand}">
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE72C;" FontSize="13"/>
                        </Button>
                    </Grid>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{Binding Device.Items}"
                                  SelectedItem="{Binding Device.Selected, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch" MinWidth="0"/>

                        <!-- Add Device: TCP/IP connect or Pair -->
                        <Button Grid.Column="1" x:Name="AddDeviceButton" Padding="10,8"
                                ToolTipService.ToolTip="Add Device">
                            <Button.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                    <MenuFlyoutItem Text="TCP/IP Connect" Click="AdbConnectMenu_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE8A7;"/>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Pair" Click="AdbPairMenu_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE8A5;"/>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Button.Flyout>
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE710;" FontSize="13"/>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Connect button -->
            <Button Grid.Row="1" Height="48" Margin="0,16,0,0" HorizontalAlignment="Stretch"
                    Command="{Binding ConnectCommand}"
                    Style="{ThemeResource AccentButtonStyle}">
                <TextBlock Text="{Binding ConnectLabel}" FontSize="14" FontWeight="SemiBold"/>
            </Button>

            <!-- Traffic section label -->
            <Grid Grid.Row="2" Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="TRAFFIC" FontSize="11" FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" Fill="{Binding Status.TunnelDotBrush}"/>
                    <TextBlock Text="{Binding Status.TunnelText}" FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Grid>

            <!-- Traffic card -->
            <Border Grid.Row="3" CornerRadius="12" BorderThickness="1" Margin="0,10,0,0"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Padding="16,14">
                <StackPanel Spacing="12">
                    <ctrl:AreaChart Height="120"
                                    UplinkSeries="{Binding Traffic.UplinkSeries}"
                                    DownlinkSeries="{Binding Traffic.DownlinkSeries}"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="8" Height="8" Fill="#22D3EE"/>
                            <TextBlock Text="UPLINK" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="{Binding Traffic.UplinkValue}" FontSize="11"
                                       Foreground="#22D3EE"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="8" Height="8" Fill="#22C55E"/>
                            <TextBlock Text="DOWNLINK" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="{Binding Traffic.DownlinkValue}" FontSize="11"
                                       Foreground="#22C55E"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Bottom status bar -->
            <Border Grid.Row="4" CornerRadius="12" BorderThickness="1" Margin="0,16,0,0"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Padding="14,11">
                <StackPanel Spacing="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                            <Ellipse Width="10" Height="10" Fill="{Binding Status.DotBrush}"/>
                            <TextBlock Text="{Binding Status.Text}" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="WebSocket &#183; Android" FontSize="10.5"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Text="{Binding AdbMessage}" FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
