<Page
    x:Class="AdbTether.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="20,14,20,18" Spacing="12">

            <!-- Header -->
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Image Grid.Column="0" Width="48" Height="48" VerticalAlignment="Top">
                    <Image.Source>
                        <SvgImageSource UriSource="ms-appx:///Assets/adbtether.svg"/>
                    </Image.Source>
                </Image>
                <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="AdbTether" FontSize="22" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    <TextBlock Text="Share your Android phone's internet connection with this PC over ADB - no root required, full TCP + UDP."
                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>

            <!-- Version card -->
            <Border CornerRadius="8" BorderThickness="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <Grid Padding="16,12" ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock Text="Version" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="Engine: Rust + WebSocket + Wintun" FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="0.1.0" FontSize="13"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- GitHub card -->
            <Border CornerRadius="8" BorderThickness="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <Grid Padding="16,12" ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0" FontFamily="Segoe MDL2 Assets" Glyph="&#xE943;"
                              FontSize="16" VerticalAlignment="Center"
                              Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Text="GitHub" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="Source code, issues and releases" FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <HyperlinkButton x:Name="GitHubLink" Grid.Column="2" Padding="12,6"
                                     VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Open"/>
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE8A7;" FontSize="12"/>
                        </StackPanel>
                    </HyperlinkButton>
                </Grid>
            </Border>

            <!-- Dependencies header -->
            <TextBlock Text="Dependencies" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,0"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>

            <!-- .NET / C# section -->
            <TextBlock Text=".NET / C#" FontSize="13" FontWeight="SemiBold"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>

            <Border CornerRadius="8" BorderThickness="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <StackPanel>
                    <!-- Microsoft.WindowsAppSDK -->
                    <Grid Padding="16,10" ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="1">
                            <TextBlock Text="Microsoft.WindowsAppSDK" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="Windows App SDK for WinUI 3 desktop apps" FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" FontSize="11" VerticalAlignment="Center">
                            <Hyperlink NavigateUri="https://github.com/microsoft/WindowsAppSDK/blob/main/LICENSE" UnderlineStyle="None"
                                       Foreground="{ThemeResource AccentFillColorDefaultBrush}">MIT</Hyperlink>
                        </TextBlock>
                    </Grid>
                    <!-- AdvancedSharpAdbClient -->
                    <Grid Padding="16,10" ColumnSpacing="14" BorderThickness="0,1,0,0"
                          BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="1">
                            <TextBlock Text="AdvancedSharpAdbClient" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="Android Debug Bridge client for .NET" FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" FontSize="11" VerticalAlignment="Center">
                            <Hyperlink NavigateUri="https://github.com/sharpadb/AdvancedSharpAdbClient/blob/master/LICENSE" UnderlineStyle="None"
                                       Foreground="{ThemeResource AccentFillColorDefaultBrush}">Apache-2.0</Hyperlink>
                        </TextBlock>
                    </Grid>
                    <!-- Android ADB (platform-tools) -->
                    <Grid Padding="16,10" ColumnSpacing="14" BorderThickness="0,1,0,0"
                          BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="1">
                            <TextBlock Text="Android ADB (platform-tools)" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="Device bridge protocol used over USB / TCP" FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" FontSize="11" VerticalAlignment="Center">
                            <Hyperlink NavigateUri="https://android.googlesource.com/platform/packages/modules/adb/" UnderlineStyle="None"
                                       Foreground="{ThemeResource AccentFillColorDefaultBrush}">Apache-2.0</Hyperlink>
                        </TextBlock>
                    </Grid>
                    <!-- System.ServiceProcess.ServiceController -->
                    <Grid Padding="16,10" ColumnSpacing="14" BorderThickness="0,1,0,0"
                          BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="1">
                            <TextBlock Text="System.ServiceProcess.ServiceController" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="Windows Service management" FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" FontSize="11" VerticalAlignment="Center">
                            <Hyperlink NavigateUri="https://github.com/dotnet/runtime/blob/main/LICENSE.TXT" UnderlineStyle="None"
                                       Foreground="{ThemeResource AccentFillColorDefaultBrush}">MIT</Hyperlink>
                        </TextBlock>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Rust section -->
            <TextBlock Text="Rust" FontSize="13" FontWeight="SemiBold" Margin="0,4,0,4"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

            <Border CornerRadius="8" BorderThickness="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <StackPanel>
                    <!-- tokio -->
                    <Grid Padding="16,10" ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="1">
                            <TextBlock Text="tokio" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="Async runtime for Rust" FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" FontSize="11" VerticalAlignment="Center">
                            <Hyperlink NavigateUri="https://github.com/tokio-rs/tokio/blob/master/LICENSE" UnderlineStyle="None"
                                       Foreground="{ThemeResource AccentFillColorDefaultBrush}">MIT</Hyperlink>
                        </TextBlock>
                    </Grid>
                    <!-- smoltcp -->
                    <Grid Padding="16,10" ColumnSpacing="14" BorderThickness="0,1,0,0"
                          BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="1">
                            <TextBlock Text="smoltcp" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="Lightweight TCP/IP stack in Rust" FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" FontSize="11" VerticalAlignment="Center">
                            <Hyperlink NavigateUri="https://github.com/smoltcp-rs/smoltcp/blob/main/LICENSE-0-BSD" UnderlineStyle="None"
                                       Foreground="{ThemeResource AccentFillColorDefaultBrush}">0BSD</Hyperlink>
                        </TextBlock>
                    </Grid>
                    <!-- wintun -->
                    <Grid Padding="16,10" ColumnSpacing="14" BorderThickness="0,1,0,0"
                          BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="1">
                            <TextBlock Text="wintun" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="Layer 3 TUN driver for Windows" FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" FontSize="11" VerticalAlignment="Center">
                            <Hyperlink NavigateUri="https://github.com/nulldotblack/wintun/blob/master/LICENSE" UnderlineStyle="None"
                                       Foreground="{ThemeResource AccentFillColorDefaultBrush}">MIT</Hyperlink>
                        </TextBlock>
                    </Grid>
                    <!-- wintun.dll (native driver) -->
                    <Grid Padding="16,10" ColumnSpacing="14" BorderThickness="0,1,0,0"
                          BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="1">
                            <TextBlock Text="wintun.dll" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="Official signed TUN driver for Windows (WireGuard / zx2c4)" FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" FontSize="11" VerticalAlignment="Center">
                            <Hyperlink NavigateUri="https://www.wintun.net/" UnderlineStyle="None"
                                       Foreground="{ThemeResource AccentFillColorDefaultBrush}">MIT</Hyperlink>
                        </TextBlock>
                    </Grid>
                    <!-- tokio-tungstenite -->
                    <Grid Padding="16,10" ColumnSpacing="14" BorderThickness="0,1,0,0"
                          BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="1">
                            <TextBlock Text="tokio-tungstenite" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="Async WebSocket client/server for tokio" FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" FontSize="11" VerticalAlignment="Center">
                            <Hyperlink NavigateUri="https://github.com/snapview/tokio-tungstenite/blob/master/LICENSE-MIT" UnderlineStyle="None"
                                       Foreground="{ThemeResource AccentFillColorDefaultBrush}">MIT</Hyperlink>
                        </TextBlock>
                    </Grid>
                    <!-- anyhow -->
                    <Grid Padding="16,10" ColumnSpacing="14" BorderThickness="0,1,0,0"
                          BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="1">
                            <TextBlock Text="anyhow" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="Flexible error handling for Rust" FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" FontSize="11" VerticalAlignment="Center">
                            <Hyperlink NavigateUri="https://github.com/dtolnay/anyhow/blob/master/LICENSE-APACHE" UnderlineStyle="None"
                                       Foreground="{ThemeResource AccentFillColorDefaultBrush}">Apache-2.0</Hyperlink>
                        </TextBlock>
                    </Grid>
                    <!-- serde + serde_json -->
                    <Grid Padding="16,10" ColumnSpacing="14" BorderThickness="0,1,0,0"
                          BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="1">
                            <TextBlock Text="serde + serde_json" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="Serialization/deserialization framework" FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" FontSize="11" VerticalAlignment="Center">
                            <Hyperlink NavigateUri="https://github.com/serde-rs/serde/blob/master/LICENSE-APACHE" UnderlineStyle="None"
                                       Foreground="{ThemeResource AccentFillColorDefaultBrush}">Apache-2.0</Hyperlink>
                        </TextBlock>
                    </Grid>
                    <!-- futures-util -->
                    <Grid Padding="16,10" ColumnSpacing="14" BorderThickness="0,1,0,0"
                          BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="1">
                            <TextBlock Text="futures-util" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="Utilities for async futures" FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" FontSize="11" VerticalAlignment="Center">
                            <Hyperlink NavigateUri="https://github.com/rust-lang/futures-rs/blob/master/LICENSE-APACHE" UnderlineStyle="None"
                                       Foreground="{ThemeResource AccentFillColorDefaultBrush}">Apache-2.0</Hyperlink>
                        </TextBlock>
                    </Grid>
                    <!-- rand -->
                    <Grid Padding="16,10" ColumnSpacing="14" BorderThickness="0,1,0,0"
                          BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="1">
                            <TextBlock Text="rand" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="Random number generation for Rust" FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" FontSize="11" VerticalAlignment="Center">
                            <Hyperlink NavigateUri="https://github.com/rust-random/rand/blob/master/LICENSE-APACHE" UnderlineStyle="None"
                                       Foreground="{ThemeResource AccentFillColorDefaultBrush}">Apache-2.0</Hyperlink>
                        </TextBlock>
                    </Grid>
                    <!-- once_cell -->
                    <Grid Padding="16,10" ColumnSpacing="14" BorderThickness="0,1,0,0"
                          BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="1">
                            <TextBlock Text="once_cell" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="Single-cell global variables for Rust" FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" FontSize="11" VerticalAlignment="Center">
                            <Hyperlink NavigateUri="https://github.com/matklad/once_cell/blob/master/LICENSE-APACHE" UnderlineStyle="None"
                                       Foreground="{ThemeResource AccentFillColorDefaultBrush}">Apache-2.0</Hyperlink>
                        </TextBlock>
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>


