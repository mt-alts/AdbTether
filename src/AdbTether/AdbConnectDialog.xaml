<views:ThemedContentDialog
    x:Class="AdbTether.AdbConnectDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:AdbTether.Views"
    Title="TCP/IP Connect"
    PrimaryButtonText="Connect"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    Style="{StaticResource DefaultContentDialogStyle}">
    <StackPanel Spacing="12" MinWidth="280">
        <StackPanel Spacing="4">
            <TextBlock Text="IP Address" FontSize="12" FontWeight="SemiBold"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <TextBox x:Name="IpAddressTextBox" Height="36"
                     Text="{Binding IpAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>
        <StackPanel Spacing="4">
            <TextBlock Text="Port" FontSize="12" FontWeight="SemiBold"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <TextBox x:Name="PortTextBox" Height="36"
                     Text="{Binding Port, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>
        <TextBlock FontSize="11.5"
                   Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                   TextWrapping="Wrap"
                   Text="{Binding ErrorMessage}"/>
    </StackPanel>
</views:ThemedContentDialog>
