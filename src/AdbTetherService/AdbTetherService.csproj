<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>AdbTetherService</RootNamespace>
    <AssemblyName>AdbTetherService</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWindowsForms>false</UseWindowsForms>
    <StartupObject>AdbTetherService.Program</StartupObject>
    <Version>0.1.3</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="9.0.6" />
    <PackageReference Include="System.Diagnostics.EventLog" Version="9.0.6" />
  </ItemGroup>

  <ItemGroup>
    <!-- Rust engine (cdylib) + wintun, copied next to the service binary -->
    <None Include="..\..\target\release\adbtether_core.dll" Link="AdbTether_core.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\crates\engine\wintun.dll" Link="wintun.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
