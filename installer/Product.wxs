<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package Name="AdbTether" Manufacturer="AdbTether"
           Version="0.1.6.0" UpgradeCode="{376E0119-4DE5-4D21-A82B-E5EFA9785F8D}"
           Scope="perMachine" InstallerVersion="500" Compressed="yes">

    <SummaryInformation Description="AdbTether - phone-tethered VPN tunnel for Windows" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />

    <util:CloseApplication Id="CloseAdbTether" Target="AdbTether.exe"
                           CloseMessage="no" RebootPrompt="no" TerminateProcess="1" />

    <Property Id="INSTALLDESKTOPSHORTCUT" Value="1" />
    <Property Id="INSTALLSTARTMENUSHORTCUT" Value="1" />

    <WixVariable Id="WixUILicenseRtf" Value="installer\License.rtf" />
    <WixVariable Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch AdbTether" />

    <CustomAction Id="LaunchApplication" Directory="APPDIR" ExeCommand="AdbTether.exe"
                  Execute="immediate" Impersonate="yes" Return="asyncNoWait" />

    <UI>
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction"
               Value="LaunchApplication"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed" />

      <Publish Dialog="InstallDirDlg" Control="Next" Event="NewDialog"
               Value="ShortcutsDlg" Order="3"
               Condition="NOT Installed AND WIXUI_INSTALLDIR_VALID = 1" />

      <Publish Dialog="LicenseAgreementDlg" Control="Next" Event="NewDialog"
               Value="InstallDirDiskDlg" Order="10"
               Condition="LicenseAccepted = &quot;1&quot;" />

      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog"
               Value="ShortcutsDlg" Order="10"
               Condition="NOT Installed" />

      <Dialog Id="ShortcutsDlg" X="50" Y="50" Width="370" Height="270" Title="[ProductName] Setup">
      <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17"
               Text="&amp;Next" Default="yes">
        <Publish Event="NewDialog" Value="VerifyReadyDlg" />
      </Control>
      <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="&amp;Back">
        <Publish Event="NewDialog" Value="InstallDirDiskDlg" />
      </Control>
      <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17"
               Text="Cancel" Cancel="yes">
        <Publish Event="SpawnDialog" Value="CancelDlg" />
      </Control>
      <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44"
               Text="WixUI_Bmp_Banner" Disabled="yes" TabSkip="no" />
      <Control Id="Description" Type="Text" X="25" Y="23" Width="280" Height="15"
               Text="Choose which shortcuts setup should create." Transparent="yes" NoPrefix="yes" TabSkip="yes" />
      <Control Id="Title" Type="Text" X="15" Y="6" Width="200" Height="15"
               Text="{\WixUI_Font_Title}Shortcuts" Transparent="yes" NoPrefix="yes" TabSkip="yes" />
      <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="373" Height="0" Disabled="yes" TabSkip="yes" />
      <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="373" Height="0" Disabled="yes" TabSkip="yes" />
      <Control Id="DesktopShortcutCheckBox" Type="CheckBox" X="20" Y="80" Width="300" Height="17"
               Text="Create a desktop shortcut" Property="INSTALLDESKTOPSHORTCUT" CheckBoxValue="1" />
      <Control Id="StartMenuShortcutCheckBox" Type="CheckBox" X="20" Y="105" Width="300" Height="17"
               Text="Create a Start menu shortcut" Property="INSTALLSTARTMENUSHORTCUT" CheckBoxValue="1" />
      </Dialog>

      <Dialog Id="InstallDirDiskDlg" X="50" Y="50" Width="370" Height="270" Title="[ProductName] Setup">
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17"
                 Text="&amp;Next" Default="yes">
          <Publish Event="CheckTargetPath" Value="[WIXUI_INSTALLDIR]" Order="1" />
          <Publish Condition="WIXUI_INSTALLDIR_VALID = 1" Event="SetTargetPath"
                   Value="[WIXUI_INSTALLDIR]" Order="2" />
          <Publish Condition="WIXUI_INSTALLDIR_VALID = 1" Event="NewDialog"
                   Value="ShortcutsDlg" Order="3" />
          <Publish Condition="WIXUI_INSTALLDIR_VALID &lt;&gt; 1" Event="SpawnDialog"
                   Value="InvalidDirDlg" Order="3" />
        </Control>
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="&amp;Back">
          <Publish Event="NewDialog" Value="LicenseAgreementDlg" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17"
                 Text="Cancel" Cancel="yes">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44"
                 Text="WixUI_Bmp_Banner" Disabled="yes" TabSkip="no" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="280" Height="15"
                 Text="Choose the destination folder. The list below shows available and required disk space."
                 Transparent="yes" NoPrefix="yes" TabSkip="yes" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="200" Height="15"
                 Text="{\WixUI_Font_Title}Destination Folder" Transparent="yes" NoPrefix="yes" TabSkip="yes" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="373" Height="0" Disabled="yes" TabSkip="yes" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="373" Height="0" Disabled="yes" TabSkip="yes" />
        <Control Id="FolderLabel" Type="Text" X="20" Y="52" Width="290" Height="15"
                 Text="Install [ProductName] to:" NoPrefix="yes" Transparent="yes" TabSkip="yes" />
        <Control Id="Folder" Type="PathEdit" X="20" Y="68" Width="320" Height="18"
                 Indirect="yes" Property="WIXUI_INSTALLDIR" TabSkip="no" />
        <Control Id="ChangeFolder" Type="PushButton" X="20" Y="90" Width="56" Height="17" Text="&amp;Change...">
          <Publish Property="_BrowseProperty" Value="[WIXUI_INSTALLDIR]" />
          <Publish Event="SpawnDialog" Value="BrowseDlg" />
          <Publish Event="SetTargetPath" Value="[WIXUI_INSTALLDIR]" />
        </Control>
        <Control Id="DiskSpaceLabel" Type="Text" X="20" Y="118" Width="300" Height="15"
                 Text="Available and required disk space:" NoPrefix="yes" Transparent="yes" TabSkip="yes" />
        <Control Id="VolumeList" Type="VolumeCostList" X="20" Y="135" Width="330" Height="85"
                 Text="{85}{55}{60}{60}{60}" Sunken="yes" Fixed="yes" Remote="yes" TabSkip="yes" />
      </Dialog>
    </UI>

    <!-- AdbTether targets .NET 10. Refuse a fresh install without the x64
         runtime instead of leaving AdbTetherService failing with error 1053. -->
    <Property Id="DOTNET_RUNTIME">
      <DirectorySearch Id="DotNetDirectory" Path="[ProgramFiles64Folder]dotnet">
        <FileSearch Id="DotNetHost" Name="dotnet.exe" MinVersion="10.0.0.0" />
      </DirectorySearch>
    </Property>

    <!-- Windows Installer reports VersionNT 6.3 and WindowsBuild 9600 on
         Windows 10 and 11 for compatibility, so read the real version from
         the registry instead. -->
    <Property Id="OS_MAJOR">
      <RegistrySearch Id="OSMajorVersion" Root="HKLM"
                      Key="SOFTWARE\Microsoft\Windows NT\CurrentVersion"
                      Name="CurrentMajorVersionNumber" Type="raw" Bitness="always64" />
    </Property>

    <Property Id="OS_BUILD">
      <RegistrySearch Id="OSBuildNumber" Root="HKLM"
                      Key="SOFTWARE\Microsoft\Windows NT\CurrentVersion"
                      Name="CurrentBuildNumber" Type="raw" Bitness="always64" />
    </Property>

    <Launch Condition="Installed OR (VersionNT64 AND (OS_MAJOR = &quot;#10&quot; OR OS_MAJOR = &quot;10&quot;) AND OS_BUILD &gt;= &quot;17763&quot;)"
            Message="AdbTether requires 64-bit Windows 10 version 1809 (build 17763) or newer, or Windows 11." />


    <Launch Condition="Installed OR DOTNET_RUNTIME"
            Message="AdbTether requires the .NET 10 Runtime (x64). Install it from https://dotnet.microsoft.com/download/dotnet/10.0 and run setup again." />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="AdbTether">
        <Directory Id="APPDIR" Name="app" />
        <Directory Id="SERVICEDIR" Name="service" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="MenuDir" Name="AdbTether">
        <Component Id="StartMenuShortcut" Guid="{8976E1BF-07AF-422F-B41F-AA217509647F}"
                   Condition="INSTALLSTARTMENUSHORTCUT = 1">
          <Shortcut Id="SmShortcut" Name="AdbTether"
                    Target="[APPDIR]AdbTether.exe" WorkingDirectory="APPDIR" />
          <RemoveFolder Directory="MenuDir" On="uninstall" />
          <RegistryValue Root="HKCU" Key="Software\AdbTether"
                         Name="sm" Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="{D36B929B-A6C9-4AC6-B19B-97EF4CAD3E35}"
                 Condition="INSTALLDESKTOPSHORTCUT = 1">
        <Shortcut Id="DeskShortcut" Name="AdbTether"
                  Target="[APPDIR]AdbTether.exe" WorkingDirectory="APPDIR" />
        <RegistryValue Root="HKCU" Key="Software\AdbTether"
                       Name="desk" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <!-- Service files come from ServiceFiles.wxs fragment -->

    <Feature Id="Main" Title="AdbTether" Level="1">
      <ComponentGroupRef Id="AppFilesGroup" />
      <ComponentGroupRef Id="ServiceFilesGroup" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>
  </Package>
</Wix>



